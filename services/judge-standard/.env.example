# ============================================
# Judge-Standard Worker Environment Variables
# ============================================

# Service
SERVICE_NAME=judge-standard
LOG_LEVEL=info
ENVIRONMENT=development

# Database (same as submission-service — shared DB)
DATABASE_URL=postgresql+asyncpg://problem_user:secure_password_change_me@postgres:5432/problems_db

# Connection Pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Queue Configuration
STANDARD_JUDGE_QUEUE=standard_judge_queue
RESULTS_QUEUE=results_queue

# gRPC — problem-service
PROBLEM_SERVICE_GRPC=problem-service:50051

# Worker
PREFETCH_COUNT=1
