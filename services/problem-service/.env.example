# ===========================
# Problem Service Environment
# ===========================

# Service
SERVICE_NAME=problem-service
SERVICE_PORT=8001
LOG_LEVEL=info
ENVIRONMENT=development

# Database - PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=problem_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=problems_db

# Derived connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://problem_user:secure_password_change_me@postgres:5432/problems_db

# Connection Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# CORS (for Phase 5 integration)
ALLOWED_ORIGINS=["http://localhost", "http://localhost:3000"]
