# Service
SERVICE_NAME=submission-service
SERVICE_PORT=8002
LOG_LEVEL=info
ENVIRONMENT=development

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://submission_user:secure_password_change_me@postgres:5432/submissions_db

# Connection Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Queue Configuration
STANDARD_JUDGE_QUEUE=standard_judge_queue
QUEUE_DURABLE=true
MESSAGE_TTL=3600000
SUBMISSION_RETRY_MAX=3
SUBMISSION_RETRY_DELAY=5000

# Problem Service
PROBLEM_SERVICE_URL=http://problem-service:8001
PROBLEM_SERVICE_TIMEOUT=10

# CORS
ALLOWED_ORIGINS=["http://localhost", "http://localhost:3000"]
